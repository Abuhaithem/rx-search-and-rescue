# Template only — put REAL values in .env (gitignored), never in this file.

# ── Database (RDS Postgres, required) ────────────────────────────────
# sslmode=verify-full = verified TLS against the RDS CA bundle
# (deploy/docker-compose.yml mounts rds-global-bundle.pem and sets
# NODE_EXTRA_CA_CERTS). Outside compose, export NODE_EXTRA_CA_CERTS yourself
# or fall back to sslmode=require (encrypted but unverified).
# e.g. postgres://postgres:PASSWORD@rxsr-db.xxxxxx.us-east-2.rds.amazonaws.com:5432/rxsr?sslmode=verify-full
DATABASE_URL=

# ── Object storage (S3, required) ────────────────────────────────────
# Private, KMS-encrypted bucket holding uploaded PDFs + generated reports.
# Credentials resolve via the standard AWS chain: EC2 instance role in
# production (no keys on disk); locally `aws configure`.
S3_BUCKET=
AWS_REGION=

# ── Worker (required for ingestion pipeline) ─────────────────────────
# docker-compose overrides this to the internal redis container.
REDIS_URL=redis://localhost:6379

# ── Extraction provider (worker, required) ───────────────────────────
# Which LLM extracts PDFs at ingestion time: anthropic | openai | gemini.
# Only the selected provider's API key is required, and that vendor needs a
# signed BAA. RxC intake and xlsx workbooks are parsed deterministically —
# the LLM only reads formulary/pharmacy-directory PDFs and the RxC fallback.
EXTRACTION_PROVIDER=anthropic
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=

# Optional model overrides (blank = per-provider default; see
# apps/worker/src/lib/extraction). EXTRACTION_ESCALATION_MODEL retries pages
# that fail the text-layer cross-check; empty string disables escalation.
EXTRACTION_MODEL=
EXTRACTION_ESCALATION_MODEL=

# ── Deploy (docker-compose only) ─────────────────────────────────────
# Public hostname Caddy serves (TLS cert is provisioned automatically).
SITE_ADDRESS=localhost
