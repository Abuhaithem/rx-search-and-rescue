# ── Supabase (required) ──────────────────────────────────────────────
# Template only — put REAL values in .env (gitignored), never in this file.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# Postgres connection string — use the SESSION POOLER URI (host contains
# ".pooler.supabase.com", port 5432). The "direct connection" host is
# IPv6-only and fails on most home/office networks.
DATABASE_URL=
# Private Storage bucket holding uploaded PDFs + generated reports
SUPABASE_STORAGE_BUCKET=documents

# ── Worker (required for ingestion pipeline) ─────────────────────────
REDIS_URL=redis://localhost:6379

# ── Extraction provider (worker) ─────────────────────────────────────
# Which LLM extracts PDFs at ingestion time: anthropic | openai | gemini.
# Only the selected provider's API key is required. PHI note: use a vendor
# with a signed BAA (DeepSeek was ruled out for exactly that reason).
# RxC intake is parsed deterministically — the LLM is only used for
# formulary/pharmacy-directory ingestion and as an RxC fallback.
EXTRACTION_PROVIDER=anthropic
# Override the per-provider default extraction model. Defaults:
#   anthropic → claude-haiku-4-5      (~$1/$5 per MTok in/out)
#   openai    → gpt-5-mini            (low-cost mini tier — verify current pricing)
#   gemini    → gemini-2.5-flash-lite (lowest-cost Gemini tier — verify current pricing)
EXTRACTION_MODEL=
# Model used to retry formulary pages that fail the text-layer cross-check.
# Empty string disables escalation. Defaults:
#   anthropic → claude-sonnet-5       (~$3/$15 per MTok; intro $2/$10 through 2026-08-31)
#   openai    → none (set explicitly to OpenAI's current top model)
#   gemini    → gemini-3-flash
EXTRACTION_ESCALATION_MODEL=

# Provider API keys (only the selected provider's key is needed)
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=

# ── Optional ─────────────────────────────────────────────────────────
# RxNorm API base (free NLM service; default is public endpoint)
RXNORM_API_BASE=https://rxnav.nlm.nih.gov/REST
# NPPES NPI registry API
NPPES_API_BASE=https://npiregistry.cms.hhs.gov/api
