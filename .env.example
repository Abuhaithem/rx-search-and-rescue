# Template only — put REAL values in .env (gitignored), never in this file.

# ── Database (RDS Postgres, required) ────────────────────────────────
# sslmode=verify-full = verified TLS against the RDS CA bundle
# (deploy/docker-compose.yml mounts rds-global-bundle.pem and sets
# NODE_EXTRA_CA_CERTS). Outside compose, export NODE_EXTRA_CA_CERTS yourself
# or fall back to sslmode=require (encrypted but unverified).
# e.g. postgres://postgres:PASSWORD@rxsr-db.xxxxxx.us-east-2.rds.amazonaws.com:5432/rxsr?sslmode=verify-full
DATABASE_URL=

# ── Object storage (S3, required) ────────────────────────────────────
# Private, KMS-encrypted bucket holding uploaded PDFs + generated reports.
# Credentials resolve via the standard AWS chain: EC2 instance role in
# production (no keys on disk); locally `aws configure`.
S3_BUCKET=
AWS_REGION=

# ── Worker (required for ingestion pipeline) ─────────────────────────
# docker-compose overrides this to the internal redis container.
REDIS_URL=redis://localhost:6379

# ── Extraction provider (worker, required) ───────────────────────────
# Which LLM extracts PDFs at ingestion time: anthropic | openai | gemini.
# Only the selected provider's API key is required, and that vendor needs a
# signed BAA. RxC intake and xlsx workbooks are parsed deterministically —
# the LLM only reads formulary/pharmacy-directory PDFs and the RxC fallback.
EXTRACTION_PROVIDER=anthropic
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=

# Optional model overrides (blank = per-provider default; see
# apps/worker/src/lib/extraction). EXTRACTION_ESCALATION_MODEL retries pages
# that fail the text-layer cross-check; empty string disables escalation.
EXTRACTION_MODEL=
EXTRACTION_ESCALATION_MODEL=

# ── Worker throughput (optional; defaults sized for 4 GB / 2 vCPU) ───
# How many formulary extractions run at once (each holds a full PDF in RAM).
WORKER_FORMULARY_CONCURRENCY=4
# Concurrency for the other ingest queues (SOB, directories, rosters, xlsx,
# CMS, RxC). Report PDF stays at 1 internally (LibreOffice takes a core).
WORKER_INGEST_CONCURRENCY=2
# Pages extracted in parallel WITHIN one formulary job (applied in order).
FORMULARY_PAGE_PARALLELISM=3
# Hard cap on simultaneous LLM calls across ALL jobs — jobs × pages never
# exceeds this, keeping provider rate limits predictable.
LLM_MAX_CONCURRENT_CALLS=8

# ── Login protection (Cloudflare Turnstile, optional) ────────────────
# Free CAPTCHA on the sign-in and forgot-password forms. Create a widget at
# dash.cloudflare.com → Turnstile (the site does NOT need to be proxied
# through Cloudflare). Both blank = feature off (widget hidden, no check).
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# ── Password-reset email (AWS SES, optional) ─────────────────────────
# From-address for reset links; must be a verified SES identity in
# AWS_REGION, and the sandbox lifted (or every recipient verified).
# Credentials come from the same AWS chain as S3. Blank = "forgot
# password" silently does nothing beyond the generic confirmation.
SES_FROM_ADDRESS=
# Public origin used inside emailed links. Blank = https://SITE_ADDRESS.
APP_BASE_URL=

# ── Deploy (docker-compose only) ─────────────────────────────────────
# Public hostname Caddy serves (TLS cert is provisioned automatically).
SITE_ADDRESS="rxsr.duckdns.org"

TURNSTILE_SITE_KEY=""
TURNSTILE_SECRET_KEY=""
SES_FROM_ADDRESS=""
APP_BASE_URL=""