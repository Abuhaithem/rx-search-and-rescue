# ── Supabase (required) ──────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# Direct Postgres connection string (Supabase → Settings → Database)
DATABASE_URL=

# ── Worker (required for ingestion pipeline) ─────────────────────────
REDIS_URL=redis://localhost:6379
ANTHROPIC_API_KEY=

# ── Optional ─────────────────────────────────────────────────────────
# RxNorm API base (free NLM service; default is public endpoint)
RXNORM_API_BASE=https://rxnav.nlm.nih.gov/REST
# NPPES NPI registry API
NPPES_API_BASE=https://npiregistry.cms.hhs.gov/api
